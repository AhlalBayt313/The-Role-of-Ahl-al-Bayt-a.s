# Copy this file to wrangler.toml (do NOT commit the real wrangler.toml if
# you ever put secrets in it directly — this project uses `wrangler secret
# put` instead, so nothing sensitive needs to live in this file at all).

name = "ahlalbayt-blog-publish"
main = "publish-worker.js"
compatibility_date = "2026-09-01"

# Non-secret config can go here as plain vars. Secrets (GITHUB_TOKEN,
# WORKER_SECRET) are set separately with `wrangler secret put NAME` — see
# README.md — so they never appear in this file or in git.
[vars]
GITHUB_OWNER = "ahlalbayt313"
GITHUB_REPO = "The-Role-of-Ahl-al-Bayt-a.s"
GITHUB_BRANCH = "main"
ALLOWED_ORIGIN = "https://ahlalbayt313.github.io"
